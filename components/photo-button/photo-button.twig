<div data-id="{{ data.id }}" data-type="{{ data.type }}" class="{{ wrapper_classes|join(' ') }}">
    <a class="{{ component_classes|join(' ') }}" href="{{ href }}" target="{{ target }}">
        <div class="button-photo__photo">
            {{ photo }}
        </div>
        {% if caption is not empty %}
            <span class="button-photo__caption">
                {{ caption }}
            </span>
        {% endif %}
    </a>
</div>

<?php

function uo_components_requirements($phase): array
{
    // TODO: Make this a runtime check instead of an install check.
    if ($phase == 'install') {
        try {
            $entityTypeManager = \Drupal::service('entity_type.manager');
            $contentTypes = $entityTypeManager->getStorage('media_type')->loadMultiple();
            if (count($contentTypes) === 0) {
                throw new \Exception('No media types found.');
            }
        }
        catch (\Exception) {
            return [
                'uo_components_media_type_check' => [
                    'title' => t('UO Components module installation requirement'),
                    'value' => t('Media types check'),
                    'description' => t('At least one media type must exist before installing the UO Components module. Please create a media type and try again.'),
                    'severity' => REQUIREMENT_ERROR,
                ],
            ];
        }
    }

    return [];
}

function uo_components_install(): void
{
    try {
        \Drupal::service('uo_components.provisioner')->provision();
    }
    catch (\Exception $e) {
        \Drupal::logger('uo_components')->error($e->getMessage());
    }
}

/**
 * Backfills manifest-owned bundles and fields on existing installations.
 */
function uo_components_update_9001(): string
{
    \Drupal::service('uo_components.provisioner')->provision();
    return 'Provisioned required UO component bundles and fields from manifest definitions.';
}
